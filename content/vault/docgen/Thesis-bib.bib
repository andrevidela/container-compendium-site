@article{yudkowskyFunctionalDecisionTheory2017,
  title = {Functional {{Decision Theory}}: {{A New Theory}} of {{Instrumental Rationality}}},
  shorttitle = {Functional {{Decision Theory}}},
  author = {Yudkowsky, Eliezer and Soares, Nate},
  year = 2017,
